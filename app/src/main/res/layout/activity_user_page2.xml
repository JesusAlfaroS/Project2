<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".UserPageActivity">

    <!-- Username (top, centered) -->
    <TextView
        android:id="@+id/userPageUsernameTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="username"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="72dp" />

    <!-- Points under username -->
    <TextView
        android:id="@+id/userPagePointsTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Points: 0"
        android:textSize="14sp"
        app:layout_constraintTop_toBottomOf="@id/userPageUsernameTextView"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="4dp" />

    <!-- Title: Today's challenge -->
    <TextView
        android:id="@+id/userPageTitleTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Today's challenge"
        android:textSize="22sp"
        app:layout_constraintTop_toBottomOf="@id/userPagePointsTextView"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="24dp" />

    <!-- Timer text (e.g. Time left: 12s) -->
    <TextView
        android:id="@+id/userPageTimerTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Time left: 30s"
        android:textSize="12sp"
        app:layout_constraintTop_toBottomOf="@id/userPageTitleTextView"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="8dp" />

    <!-- Challenge text from DB -->
    <TextView
        android:id="@+id/userPageChallengeTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="No challenge yet. Please wait for admin."
        android:textSize="14sp"
        app:layout_constraintTop_toBottomOf="@id/userPageTimerTextView"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp" />

    <!-- Label: Your answer -->
    <TextView
        android:id="@+id/userPageAnswerLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Your answer"
        android:textSize="14sp"
        app:layout_constraintTop_toBottomOf="@id/userPageChallengeTextView"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="24dp"
        android:layout_marginTop="32dp" />

    <!-- User's answer input -->
    <EditText
        android:id="@+id/userPageAnswerEditText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="4dp"
        android:hint="Your answer"
        android:inputType="numberDecimal"
        android:textSize="18sp"
        app:layout_constraintTop_toBottomOf="@id/userPageAnswerLabel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Submit button -->
    <Button
        android:id="@+id/userPageSubmitButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="SUBMIT"
        android:textSize="18sp"
        app:layout_constraintTop_toBottomOf="@id/userPageAnswerEditText"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="24dp" />

    <!-- Logout button -->
    <Button
        android:id="@+id/userPageLogoutButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="LOG OUT"
        android:textSize="16sp"
        app:layout_constraintTop_toBottomOf="@id/userPageSubmitButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp" />

    <!-- NEW: View Leaderboard button -->
    <Button
        android:id="@+id/userPageLeaderboardButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="View Leaderboard"
        android:textSize="16sp"
        app:layout_constraintTop_toBottomOf="@id/userPageLogoutButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="12dp" />

</androidx.constraintlayout.widget.ConstraintLayout>
